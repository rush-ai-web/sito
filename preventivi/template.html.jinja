<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<title>Preventivo {{ numero }}</title>
<style>
  @font-face {
    font-family: 'Inter';
    src: url('assets/inter.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: block;
  }

  :root {
    --ink: #06070b;
    --ink-soft: #14161f;
    --accent: #2a4bff;
    --accent-deep: #1e34c8;
    --accent-light: #6aa3ff;
    --accent-pale: #e3eaff;
    --paper: #ffffff;
    --muted-bg: #f4f6fb;
    --text: #13141a;
    --text-soft: #5b6372;
    --line: #e2e6f0;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', -apple-system, sans-serif;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }

  @page { size: A4; margin: 0; }

  .page {
    width: 210mm;
    min-height: 297mm;
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    page-break-after: always;
  }
  .page:last-child { page-break-after: auto; }

  /* ---------- HEADER ---------- */
  .hero {
    position: relative;
    height: 72mm;
    background: var(--ink);
    overflow: hidden;
  }
  .hero.compact { height: 34mm; }

  .hero-waves { position: absolute; inset: 0; width: 100%; height: 100%; }

  .hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: 12mm 14mm 0 14mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .brand-row { display: flex; align-items: center; justify-content: space-between; }

  .brand { display: flex; align-items: center; gap: 4mm; }

  .mark {
    width: 11mm; height: 11mm;
    border-radius: 3mm;
    background: linear-gradient(180deg, var(--accent), var(--accent-deep));
    display: flex; align-items: center; justify-content: center;
    font-weight: 600; color: #fff; font-size: 4.4mm; letter-spacing: 0.2px;
    flex: none;
  }

  .brand-name {
    color: #fff;
    font-size: 5.6mm;
    font-weight: 600;
    letter-spacing: 0.2px;
    line-height: 1;
  }
  .brand-tag {
    color: var(--accent-light);
    font-size: 2.6mm;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.6px;
    margin-top: 1.4mm;
  }

  .contact-cols { display: flex; gap: 10mm; text-align: right; }
  .contact-cols .col { color: #c7cbd8; }
  .contact-cols .label {
    display: block;
    font-size: 2.3mm;
    letter-spacing: 0.2px;
    color: var(--accent-light);
    font-weight: 500;
    margin-bottom: 1mm;
  }
  .contact-cols .value { font-size: 3.1mm; font-weight: 500; color: #fff; }

  .hero-bottom { padding-bottom: 9mm; }
  .doc-kicker {
    color: var(--accent-light);
    font-size: 2.6mm;
    text-transform: uppercase;
    letter-spacing: 2.4px;
    font-weight: 700;
    margin: 0 0 1.5mm 0;
  }
  .doc-title {
    color: #fff;
    font-size: 10.5mm;
    font-weight: 700;
    letter-spacing: -0.3px;
    margin: 0;
    line-height: 1;
  }

  /* ---------- BODY ---------- */
  .body { padding: 10mm 14mm 0 14mm; }

  .meta-strip {
    display: flex;
    gap: 0;
    margin-top: -13mm;
    position: relative;
    z-index: 3;
    background: var(--paper);
    border-radius: 2mm;
    box-shadow: 0 2px 10px rgba(10, 15, 40, 0.08);
    overflow: hidden;
  }
  .meta-strip .cell {
    flex: 1;
    padding: 5mm 6mm;
    border-right: 1px solid var(--line);
  }
  .meta-strip .cell:last-child { border-right: none; }
  .meta-strip .k {
    font-size: 2.5mm;
    letter-spacing: 0.1px;
    color: var(--text-soft);
    font-weight: 500;
    margin-bottom: 1.3mm;
  }
  .meta-strip .v { font-size: 3.4mm; font-weight: 600; color: var(--text); }

  .two-col { display: flex; gap: 8mm; margin-top: 8mm; }
  .two-col .block { flex: 1; }

  .section-label {
    font-size: 2.8mm;
    letter-spacing: 0.1px;
    font-weight: 600;
    color: var(--accent-deep);
    margin: 0 0 2.5mm 0;
  }

  .client-name { font-size: 4mm; font-weight: 600; margin: 0 0 1mm 0; }
  .client-line { font-size: 3.1mm; color: var(--text-soft); line-height: 1.5; margin: 0; }

  .oggetto-box {
    background: var(--muted-bg);
    border-left: 2.5px solid var(--accent);
    padding: 3.5mm 5mm;
    border-radius: 0 1.5mm 1.5mm 0;
  }
  .oggetto-box .oggetto-text { font-size: 3.6mm; font-weight: 600; color: var(--text); margin: 0; }

  .intro {
    font-size: 3.2mm;
    line-height: 1.65;
    color: var(--text-soft);
    margin: 7mm 0 0 0;
  }

  /* ---------- TABLE ---------- */
  table.items { width: 100%; border-collapse: collapse; margin-top: 7mm; }
  table.items thead th {
    background: var(--ink);
    color: #fff;
    font-size: 2.5mm;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-weight: 600;
    text-align: left;
    padding: 4mm 5mm;
  }
  table.items thead th.num { text-align: right; }
  table.items thead th:first-child { border-radius: 1.5mm 0 0 0; }
  table.items thead th:last-child { border-radius: 0 1.5mm 0 0; }

  table.items tbody tr { break-inside: avoid; }
  table.items tbody td {
    padding: 4.3mm 5mm;
    font-size: 3.2mm;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  table.items tbody tr:nth-child(even) { background: var(--muted-bg); }
  table.items tbody td.num { text-align: right; font-weight: 600; white-space: nowrap; }
  table.items tbody .voce-title { font-weight: 600; color: var(--text); }
  table.items tbody .voce-desc { color: var(--text-soft); font-size: 2.9mm; margin-top: 0.8mm; line-height: 1.45; }

  .totals { display: flex; justify-content: flex-end; margin-top: 6mm; }
  .totals-box { width: 85mm; }
  .totals-row {
    display: flex; justify-content: space-between;
    padding: 2.6mm 0;
    font-size: 3.2mm;
    color: var(--text-soft);
    border-bottom: 1px solid var(--line);
  }
  .totals-row.discount { color: var(--accent-deep); }
  .grand-total {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 3mm;
    background: linear-gradient(180deg, var(--accent), var(--accent-deep));
    border-radius: 2mm;
    padding: 5mm 6mm;
  }
  .grand-total .label {
    color: #dce6ff; font-size: 2.6mm; text-transform: uppercase;
    letter-spacing: 1.6px; font-weight: 700;
  }
  .grand-total .amount { color: #fff; font-size: 6mm; font-weight: 700; }

  .ref-note {
    margin-top: 6mm;
    font-size: 2.9mm;
    color: var(--text-soft);
    font-weight: 500;
  }

  /* ---------- FOOTER ---------- */
  .footer {
    margin: auto 14mm 10mm 14mm;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid var(--line);
    padding-top: 5mm;
    break-inside: avoid;
  }
  .footer .thanks { font-size: 3.6mm; font-weight: 600; color: var(--text); margin: 0 0 1.2mm 0; }
  .footer .thanks-sub { font-size: 2.8mm; color: var(--text-soft); margin: 0; }
  .footer .sign { text-align: right; }
  .footer .sign-name { font-family: 'Inter'; font-size: 4.4mm; font-weight: 600; color: var(--accent-deep); margin: 0 0 1mm 0; }
  .footer .sign-line { width: 42mm; border-top: 1px solid var(--text-soft); margin: 1mm 0 1.2mm auto; }
  .footer .sign-cap { font-size: 2.4mm; text-transform: uppercase; letter-spacing: 1.2px; color: var(--text-soft); }

  .page-tag {
    position: absolute;
    right: 14mm; top: 6mm;
    color: rgba(255,255,255,0.55);
    font-size: 2.6mm;
    letter-spacing: 1px;
    z-index: 3;
  }

  /* ---------- PAGE 2 ---------- */
  .detail-section { margin-top: 8mm; }
  .detail-section:first-of-type { margin-top: 10mm; }

  .cat-block { margin-top: 7mm; break-inside: avoid; }
  .cat-title {
    display: flex; align-items: center; gap: 2.5mm;
    font-size: 3.6mm; font-weight: 600; color: var(--text);
    margin: 0 0 3mm 0;
  }
  .cat-title .dot { width: 2mm; height: 2mm; border-radius: 50%; background: var(--accent); flex: none; }

  .pair-lists { display: flex; gap: 8mm; margin-top: 3mm; }
  .pair-lists .col { flex: 1; }
  .pill-title { display: flex; align-items: center; gap: 2mm; font-size: 3mm; font-weight: 700; margin: 0 0 2.5mm 0; }
  .pill-title.yes::before { content: ''; width: 2.4mm; height: 2.4mm; border-radius: 50%; background: var(--accent); display:inline-block; }
  .pill-title.no::before { content: ''; width: 2.4mm; height: 2.4mm; border-radius: 50%; background: #c7cbd8; display:inline-block; }
  ul.simple { margin: 0; padding: 0; list-style: none; }
  ul.simple li {
    font-size: 3mm; color: var(--text-soft); line-height: 1.6;
    padding-left: 3.2mm; position: relative; margin-bottom: 1mm;
  }
  ul.simple li::before { content: '—'; position: absolute; left: 0; color: var(--accent); }

  table.plain { width: 100%; border-collapse: collapse; margin-top: 3mm; }
  table.plain th {
    text-align: left; font-size: 2.4mm; text-transform: uppercase; letter-spacing: 1.2px;
    color: var(--text-soft); font-weight: 600; padding: 2.5mm 3mm; border-bottom: 1.5px solid var(--text);
  }
  table.plain th.num, table.plain td.num { text-align: right; }
  table.plain td { font-size: 3mm; padding: 3mm; border-bottom: 1px solid var(--line); color: var(--text); }
  table.plain tbody tr { break-inside: avoid; }

  .note-box {
    margin-top: 6mm;
    background: var(--muted-bg);
    border-radius: 1.5mm;
    padding: 4.5mm 5.5mm;
    font-size: 2.9mm;
    color: var(--text-soft);
    line-height: 1.6;
  }
  .note-box b { color: var(--text); }

  .accept-row { display: flex; gap: 8mm; margin-top: 9mm; break-inside: avoid; }
  .accept-box { flex: 1; border: 1px solid var(--line); border-radius: 2mm; padding: 5mm 6mm; }
  .accept-box .t { font-size: 2.6mm; text-transform: uppercase; letter-spacing: 1.3px; color: var(--text-soft); font-weight: 600; margin: 0 0 7mm 0; }
  .accept-box .l { border-top: 1px solid var(--text); margin-bottom: 1.5mm; }
  .accept-box .cap { font-size: 2.6mm; color: var(--text-soft); }
</style>
</head>
<body>

<!-- =========================================================
     PAGINA 1 — RIEPILOGO
     ========================================================= -->
<div class="page">
  <div class="hero">
    <svg class="hero-waves" viewBox="0 0 794 272" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,160 C150,220 280,110 470,150 C600,178 700,130 794,165 L794,272 L0,272 Z" fill="#0f1830" opacity="0.6"/>
      <path d="M0,190 C180,240 320,150 500,185 C650,215 720,170 794,195 L794,272 L0,272 Z" fill="#162454" opacity="0.5"/>
      <path d="M0,215 C200,260 360,195 540,220 C670,240 730,210 794,225 L794,272 L0,272 Z" fill="url(#g1)"/>
      <defs>
        <linearGradient id="g1" x1="0" y1="0" x2="794" y2="0">
          <stop offset="0" stop-color="#1e34c8"/>
          <stop offset="1" stop-color="#2a4bff"/>
        </linearGradient>
      </defs>
    </svg>
    <div class="hero-content">
      <div class="brand-row">
        <div class="brand">
          <div class="mark">SM</div>
          <div>
            <div class="brand-name">Sebastian Marzola</div>
            <div class="brand-tag">Sviluppatore Web</div>
          </div>
        </div>
        <div class="contact-cols">
          <div class="col">
            <span class="label">Cellulare</span>
            <span class="value">389 902 1020</span>
          </div>
          <div class="col">
            <span class="label">Email</span>
            <span class="value">sebastianmarzola.work@gmail.com</span>
          </div>
          <div class="col">
            <span class="label">Sito</span>
            <span class="value">sebastian-marzola.it</span>
          </div>
        </div>
      </div>
      <div class="hero-bottom">
        <p class="doc-kicker">Preventivo N. {{ numero }} · {{ data }}</p>
        <p class="doc-title">Preventivo</p>
      </div>
    </div>
  </div>

  <div class="body">
    <div class="meta-strip">
      <div class="cell">
        <div class="k">Numero</div>
        <div class="v">{{ numero }}</div>
      </div>
      <div class="cell">
        <div class="k">Data</div>
        <div class="v">{{ data }}</div>
      </div>
      <div class="cell">
        <div class="k">Validità offerta</div>
        <div class="v">{{ validita }}</div>
      </div>
      <div class="cell">
        <div class="k">Referente</div>
        <div class="v">Sebastian Marzola</div>
      </div>
    </div>

    <div class="two-col">
      <div class="block">
        <p class="section-label">Spett.le</p>
        <p class="client-name">{{ cliente.nome }}</p>
        {% if cliente.azienda %}<p class="client-line">{{ cliente.azienda }}</p>{% endif %}
        {% if cliente.email %}<p class="client-line">{{ cliente.email }}</p>{% endif %}
        {% if cliente.telefono %}<p class="client-line">{{ cliente.telefono }}</p>{% endif %}
      </div>
      <div class="block">
        <p class="section-label">Oggetto</p>
        <div class="oggetto-box">
          <p class="oggetto-text">{{ oggetto }}</p>
        </div>
      </div>
    </div>

    {% if intro %}<p class="intro">{{ intro }}</p>{% endif %}

    <table class="items">
      <thead>
        <tr>
          <th>Voce</th>
          <th class="num">Importo</th>
        </tr>
      </thead>
      <tbody>
        {% for r in riepilogo %}
        <tr>
          <td>
            <div class="voce-title">{{ r.voce }}</div>
            {% if r.descrizione %}<div class="voce-desc">{{ r.descrizione }}</div>{% endif %}
          </td>
          <td class="num">{{ r.importo }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="totals">
      <div class="totals-box">
        <div class="totals-row">
          <span>Subtotale</span>
          <span>{{ subtotale }}</span>
        </div>
        {% if sconto %}
        <div class="totals-row discount">
          <span>{{ sconto.etichetta }}</span>
          <span>− {{ sconto.importo }}</span>
        </div>
        {% endif %}
        <div class="grand-total">
          <span class="label">Totale preventivo</span>
          <span class="amount">{{ totale }}</span>
        </div>
      </div>
    </div>

    <p class="ref-note">Il dettaglio completo delle lavorazioni, i tempi di consegna e le condizioni di pagamento sono riportati a pagina 2.</p>
  </div>

  <div class="footer">
    <div>
      <p class="thanks">Grazie per la fiducia.</p>
      <p class="thanks-sub">Rimango a disposizione per qualsiasi chiarimento.</p>
    </div>
    <div class="sign">
      <p class="sign-name">Sebastian Marzola</p>
      <div class="sign-line"></div>
      <p class="sign-cap">Firma</p>
    </div>
  </div>
</div>

<!-- =========================================================
     PAGINA 2 — DETTAGLIO SERVIZIO
     ========================================================= -->
<div class="page">
  <div class="hero compact">
    <div class="page-tag">Dettaglio</div>
    <div class="hero-content" style="padding-top: 8mm;">
      <div class="brand-row">
        <div class="brand">
          <div class="mark" style="width:8mm;height:8mm;font-size:3.4mm;">SM</div>
          <div>
            <div class="brand-name" style="font-size:4.4mm;">Sebastian Marzola</div>
          </div>
        </div>
        <div>
          <p class="doc-kicker" style="margin:0;">Preventivo N. {{ numero }}</p>
        </div>
      </div>
      <div class="hero-bottom" style="padding-bottom:0;">
        <p class="doc-title" style="font-size:7mm;">Dettaglio del servizio</p>
      </div>
    </div>
  </div>

  <div class="body" style="padding-top:8mm;">

    {% for cat in dettaglio %}
    <div class="cat-block">
      <p class="cat-title"><span class="dot"></span>{{ cat.categoria }}</p>
      <table class="plain">
        <thead>
          <tr>
            <th>Descrizione</th>
            <th class="num">Quantità</th>
            <th class="num">Prezzo unit.</th>
            <th class="num">Totale</th>
          </tr>
        </thead>
        <tbody>
          {% for v in cat.voci %}
          <tr>
            <td>{{ v.descrizione }}</td>
            <td class="num">{{ v.quantita }}</td>
            <td class="num">{{ v.prezzo_unitario }}</td>
            <td class="num">{{ v.totale }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endfor %}

    {% if incluso or escluso %}
    <div class="detail-section">
      <p class="section-label">Cosa comprende</p>
      <div class="pair-lists">
        <div class="col">
          <p class="pill-title yes">Incluso</p>
          <ul class="simple">
            {% for i in incluso %}<li>{{ i }}</li>{% endfor %}
          </ul>
        </div>
        <div class="col">
          <p class="pill-title no">Non incluso</p>
          <ul class="simple">
            {% for e in escluso %}<li>{{ e }}</li>{% endfor %}
          </ul>
        </div>
      </div>
    </div>
    {% endif %}

    {% if tempistiche %}
    <div class="detail-section">
      <p class="section-label">Tempistiche</p>
      <table class="plain">
        <thead>
          <tr><th>Fase</th><th>Durata stimata</th><th class="num">Consegna</th></tr>
        </thead>
        <tbody>
          {% for t in tempistiche %}
          <tr><td>{{ t.fase }}</td><td>{{ t.durata }}</td><td class="num">{{ t.consegna }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if pagamento %}
    <div class="detail-section">
      <p class="section-label">Modalità di pagamento</p>
      <table class="plain">
        <thead>
          <tr><th>Fase</th><th class="num">Percentuale</th><th class="num">Importo</th></tr>
        </thead>
        <tbody>
          {% for p in pagamento %}
          <tr><td>{{ p.fase }}</td><td class="num">{{ p.percentuale }}</td><td class="num">{{ p.importo }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {% if note %}
    <div class="note-box"><b>Note:</b> {{ note }}</div>
    {% endif %}

    <div class="accept-row">
      <div class="accept-box">
        <p class="t">Per accettazione — Cliente</p>
        <div class="l"></div>
        <p class="cap">Nome, data e firma</p>
      </div>
      <div class="accept-box">
        <p class="t">Sebastian Marzola</p>
        <div class="l"></div>
        <p class="cap">Data e firma</p>
      </div>
    </div>
  </div>

  <div class="footer">
    <div>
      <p class="thanks-sub">389 902 1020 · sebastianmarzola.work@gmail.com · sebastian-marzola.it</p>
    </div>
  </div>
</div>

</body>
</html>
