<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<title>Preventivo {{ numero }}</title>
<style>
  @font-face {
    font-family: 'Inter';
    src: url('assets/inter.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: block;
  }

  :root {
    --ink: #06070b;
    --accent: #2a4bff;
    --accent-deep: #1e34c8;
    --accent-light: #6aa3ff;
    --accent-pale: #cfe0ff;
    --paper: #ffffff;
    --muted-bg: #f4f6fb;
    --text: #13141a;
    --text-soft: #5b6372;
    --line: #e2e6f0;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', -apple-system, sans-serif;
    color: var(--text);
    font-size: 3.2mm;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: tabular-nums;
  }

  @page { size: A4; margin: 17mm 16mm; }
  @page :first { margin: 0; }

  .page { page-break-after: always; }
  .page:last-child { page-break-after: auto; }

  .page.cover { display: flex; flex-direction: column; min-height: 297mm; }
  .page.content { display: flex; flex-direction: column; min-height: 263mm; }

  p { margin: 0; }

  /* ---------- HERO (pagina 1, a tutta pagina) ---------- */
  .hero {
    position: relative;
    height: 58mm;
    background: var(--paper);
    overflow: hidden;
  }
  .hero-waves { position: absolute; inset: 0; width: 100%; height: 100%; }

  .doc-header {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: 11mm 16mm 0 16mm;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .brand { display: flex; align-items: center; gap: 4mm; white-space: nowrap; }

  .mark {
    width: 14mm; height: 14mm;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 5px rgba(10, 15, 40, 0.18);
    display: flex; align-items: center; justify-content: center;
    flex: none;
    overflow: hidden;
  }
  .mark img { width: 88%; height: 88%; object-fit: contain; }

  .brand-name { font-size: 5mm; font-weight: 600; color: var(--text); white-space: nowrap; }
  .brand-tag { font-size: 2.7mm; font-weight: 500; color: var(--accent-deep); margin-top: 0.8mm; white-space: nowrap; }

  .doc-title-wrap { text-align: right; white-space: nowrap; }
  .doc-title {
    font-size: 8.5mm;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--text);
  }
  .doc-date { font-size: 3.1mm; color: var(--text-soft); margin-top: 1.8mm; font-weight: 500; }

  /* ---------- TAB CARD (sovrapposta al bordo dell'hero) ---------- */
  .tab-card {
    position: relative;
    z-index: 3;
    display: flex;
    margin: -15mm 16mm 0 16mm;
    background: var(--paper);
    border-radius: 2.5mm;
    box-shadow: 0 6px 18px rgba(10, 15, 40, 0.12);
    overflow: hidden;
  }
  .tab-card .cell { flex: 1; padding: 5mm 6mm; border-right: 1px solid var(--line); }
  .tab-card .cell:last-child { border-right: none; }

  /* ---------- CORPO PAGINA 1 (margini manuali: pagina 1 non usa @page margin) ---------- */
  .cover-body { flex: 1; display: flex; flex-direction: column; padding: 10mm 16mm 17mm 16mm; }

  /* ---------- META / CLIENTE / OGGETTO ---------- */
  .field-label {
    font-size: 2.7mm;
    font-weight: 600;
    color: var(--text-soft);
    margin-bottom: 1.3mm;
  }
  .field-value { font-size: 3.4mm; font-weight: 600; color: var(--text); }
  .field-sub { font-size: 3.1mm; color: var(--text-soft); margin-top: 0.8mm; line-height: 1.55; }

  .meta-grid {
    display: flex;
    justify-content: space-between;
    gap: 10mm;
    margin-top: 10mm;
  }
  .meta-col.align-right { text-align: right; }

  .oggetto-block { margin-top: 7mm; }
  .oggetto-text { font-size: 3.6mm; font-weight: 600; color: var(--text); }

  /* ---------- TABLE ---------- */
  table.items { width: 100%; border-collapse: collapse; margin-top: 8mm; }
  table.items thead th {
    background: var(--ink);
    color: #fff;
    font-size: 2.6mm;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    text-align: left;
    padding: 4mm 5mm;
  }
  table.items thead th.num { text-align: right; }
  table.items thead th:first-child { border-radius: 1.5mm 0 0 1.5mm; }
  table.items thead th:last-child { border-radius: 0 1.5mm 1.5mm 0; }

  table.items tbody tr { break-inside: avoid; }
  table.items tbody td {
    padding: 4.3mm 5mm;
    font-size: 3.2mm;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  table.items tbody tr:nth-child(even) { background: var(--muted-bg); }
  table.items tbody td.num { text-align: right; font-weight: 600; white-space: nowrap; }
  table.items tbody .voce-title { font-weight: 600; color: var(--text); }
  table.items tbody .voce-desc { color: var(--text-soft); font-size: 2.9mm; margin-top: 0.8mm; line-height: 1.45; }

  .totals { display: flex; justify-content: flex-end; margin-top: 6mm; }
  .totals-box { width: 85mm; }
  .totals-row {
    display: flex; justify-content: space-between;
    padding: 2.6mm 0;
    font-size: 3.2mm;
    color: var(--accent-deep);
    border-bottom: 1px solid var(--line);
  }
  .grand-total {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 3mm;
    background: linear-gradient(180deg, var(--accent), var(--accent-deep));
    border-radius: 2mm;
    padding: 5mm 6mm;
  }
  .grand-total .label {
    color: #dce6ff; font-size: 2.7mm; text-transform: uppercase;
    letter-spacing: 1.2px; font-weight: 600;
  }
  .grand-total .amount { color: #fff; font-size: 6mm; font-weight: 700; }

  /* ---------- CONTATTI (pagina 1 e ultima pagina, ancorati in fondo) ---------- */
  .contact-footer {
    margin-top: auto;
    padding-top: 6mm;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: center;
    gap: 14mm;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 2.6mm;
    color: var(--text-soft);
    font-size: 3mm;
    font-weight: 500;
  }
  .contact-item svg { flex: none; color: var(--accent-deep); }

  /* ---------- TITOLI DI SEZIONE (pagine 2 e 3) ---------- */
  .section-title {
    text-align: center;
    font-size: 5.6mm;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--text);
    margin: 0 auto 4mm auto;
  }
  .section-rule {
    width: 26mm; height: 1.2mm;
    margin: 0 auto 12mm auto;
    border-radius: 1mm;
    background: linear-gradient(90deg, var(--accent-light), var(--accent-deep));
  }
  .section-rule.neutral { background: var(--line); }

  .block-title {
    font-size: 4.3mm;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4mm;
  }

  /* ---------- PAGINA 2: DETTAGLIO ---------- */
  .cat-block { margin-top: 8mm; break-inside: avoid; }
  .cat-block:first-of-type { margin-top: 0; }
  .cat-title {
    font-size: 3.8mm; font-weight: 600; color: var(--text);
    padding-bottom: 2.2mm;
    border-bottom: 1px solid var(--line);
    margin-bottom: 4mm;
  }

  .detail-section { margin-top: 9mm; }

  table.plain { width: 100%; border-collapse: collapse; }
  table.plain th {
    text-align: left; font-size: 2.5mm; text-transform: uppercase; letter-spacing: 1px;
    color: var(--text-soft); font-weight: 600; padding: 2.5mm 3mm; border-bottom: 1.5px solid var(--text);
  }
  table.plain th.num, table.plain td.num { text-align: right; }
  table.plain tbody tr { break-inside: avoid; }
  table.plain td { font-size: 3mm; padding: 3mm; border-bottom: 1px solid var(--line); color: var(--text); }

  .pair-lists { display: flex; gap: 10mm; margin-top: 4mm; }
  .pair-lists .col { flex: 1; }
  .pill-title { font-size: 3.1mm; font-weight: 600; color: var(--text); margin-bottom: 2.5mm; }
  ul.simple { margin: 0; padding: 0; list-style: none; }
  ul.simple li {
    font-size: 3mm; color: var(--text-soft); line-height: 1.65;
    padding-left: 3.2mm; position: relative; margin-bottom: 1mm;
  }
  ul.simple li::before { content: '–'; position: absolute; left: 0; color: var(--text-soft); }

  /* ---------- PAGINA 3: TEMPISTICHE E PAGAMENTO ---------- */
  .stat-block { margin-top: 4mm; }
  .stat-value { font-size: 10mm; font-weight: 700; color: var(--text); }
  .stat-caption { font-size: 3.2mm; color: var(--text-soft); margin-top: 1.5mm; }

  .pay-cards { display: flex; gap: 8mm; margin-top: 4mm; }
  .pay-card {
    flex: 1;
    text-align: center;
    border: 1px solid var(--line);
    border-top: 2.5px solid var(--accent);
    border-radius: 2.5mm;
    padding: 7mm 6mm;
  }
  .pay-card .pct { font-size: 9mm; font-weight: 700; color: var(--accent-deep); }
  .pay-card .fase { font-size: 3.2mm; font-weight: 600; color: var(--text); margin-top: 2.5mm; }
  .pay-card .importo { font-size: 3mm; color: var(--text-soft); margin-top: 1mm; }

  .note-box {
    margin-top: 10mm;
    background: var(--muted-bg);
    border-radius: 1.5mm;
    padding: 4.5mm 5.5mm;
    font-size: 2.9mm;
    color: var(--text-soft);
    line-height: 1.6;
  }
</style>
</head>
<body>

<!-- =========================================================
     PAGINA 1 — RIEPILOGO
     ========================================================= -->
<div class="page cover">

  <div class="hero">
    <svg class="hero-waves" viewBox="0 0 794 212" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,110 C150,150 280,95 470,120 C600,140 700,110 794,130 L794,212 L0,212 Z" fill="#cfe0ff" opacity="0.55"/>
      <path d="M0,135 C180,170 320,118 500,140 C650,158 720,132 794,148 L794,212 L0,212 Z" fill="#6aa3ff" opacity="0.5"/>
      <path d="M0,160 C200,188 360,148 540,163 C670,174 730,153 794,163 L794,212 L0,212 Z" fill="url(#g1)"/>
      <defs>
        <linearGradient id="g1" x1="0" y1="0" x2="794" y2="0">
          <stop offset="0" stop-color="#1e34c8"/>
          <stop offset="1" stop-color="#2a4bff"/>
        </linearGradient>
      </defs>
    </svg>
    <div class="doc-header">
      <div class="brand">
        <div class="mark"><img src="assets/logo.png" alt=""></div>
        <div>
          <div class="brand-name">Sebastian Marzola</div>
          <div class="brand-tag">Sviluppatore Web</div>
        </div>
      </div>
      <div class="doc-title-wrap">
        <p class="doc-title">Preventivo</p>
        <p class="doc-date">{{ data }}</p>
      </div>
    </div>
  </div>

  <div class="tab-card">
    <div class="cell">
      <p class="field-label">Data</p>
      <p class="field-value">{{ data }}</p>
    </div>
    <div class="cell">
      <p class="field-label">Validità offerta</p>
      <p class="field-value">{{ validita }}</p>
    </div>
    <div class="cell">
      <p class="field-label">Referente</p>
      <p class="field-value">Sebastian Marzola</p>
    </div>
  </div>

  <div class="cover-body">

  <div class="meta-grid">
    <div class="meta-col">
      <p class="field-label">Spett.le</p>
      <p class="field-value">{{ cliente.nome }}</p>
      {% if cliente.azienda %}<p class="field-sub">{{ cliente.azienda }}</p>{% endif %}
      {% if cliente.email %}<p class="field-sub">{{ cliente.email }}</p>{% endif %}
      {% if cliente.telefono %}<p class="field-sub">{{ cliente.telefono }}</p>{% endif %}
    </div>
    <div class="meta-col align-right">
      <p class="field-label">Oggetto</p>
      <p class="oggetto-text">{{ oggetto }}</p>
    </div>
  </div>

  <table class="items">
    <thead>
      <tr>
        <th>Voce</th>
        <th class="num">Importo</th>
      </tr>
    </thead>
    <tbody>
      {% for r in riepilogo %}
      <tr>
        <td>
          <div class="voce-title">{{ r.voce }}</div>
          {% if r.descrizione %}<div class="voce-desc">{{ r.descrizione }}</div>{% endif %}
        </td>
        <td class="num">{{ r.importo }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="totals">
    <div class="totals-box">
      {% if sconto %}
      <div class="totals-row">
        <span>{{ sconto.etichetta }}</span>
        <span>− {{ sconto.importo }}</span>
      </div>
      {% endif %}
      <div class="grand-total">
        <span class="label">Totale preventivo</span>
        <span class="amount">{{ totale }}</span>
      </div>
    </div>
  </div>

  <div class="contact-footer">
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="4.2mm" height="4.2mm">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span>389 902 1020</span>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="4.2mm" height="4.2mm">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <span>sebastianmarzola.work@gmail.com</span>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="4.2mm" height="4.2mm">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
        <path d="M2 12h20"/>
      </svg>
      <span>sebastian-marzola.it</span>
    </div>
  </div>
  </div>
</div>

<!-- =========================================================
     PAGINA 2 — DETTAGLIO SERVIZIO
     ========================================================= -->
<div class="page content">

  <h1 class="section-title">Dettaglio del servizio</h1>
  <div class="section-rule neutral"></div>

  {% for cat in dettaglio %}
  <div class="cat-block">
    <p class="cat-title">{{ cat.categoria }}</p>
    <table class="plain">
      <thead>
        <tr>
          <th>Descrizione</th>
          <th class="num">Quantità</th>
          <th class="num">Prezzo unit.</th>
          <th class="num">Totale</th>
        </tr>
      </thead>
      <tbody>
        {% for v in cat.voci %}
        <tr>
          <td>{{ v.descrizione }}</td>
          <td class="num">{{ v.quantita }}</td>
          <td class="num">{{ v.prezzo_unitario }}</td>
          <td class="num">{{ v.totale }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}

  {% if incluso or escluso %}
  <div class="detail-section">
    <p class="block-title">Cosa comprende</p>
    <div class="pair-lists">
      <div class="col">
        <p class="pill-title">Incluso</p>
        <ul class="simple">
          {% for i in incluso %}<li>{{ i }}</li>{% endfor %}
        </ul>
      </div>
      <div class="col">
        <p class="pill-title">Non incluso</p>
        <ul class="simple">
          {% for e in escluso %}<li>{{ e }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
  {% endif %}
</div>

{% if tempistiche or pagamento %}
<!-- =========================================================
     PAGINA 3 — TEMPISTICHE E PAGAMENTO (sempre su pagina propria)
     ========================================================= -->
<div class="page content">

  <h1 class="section-title">Tempistiche e pagamento</h1>
  <div class="section-rule"></div>

  {% if tempistiche %}
  <div class="detail-section" style="margin-top:0;">
    <p class="block-title">Tempistiche</p>
    <div class="stat-block">
      <div class="stat-value">{{ tempistiche.durata }}</div>
      <div class="stat-caption">Tempo di consegna stimato{% if tempistiche.nota %} {{ tempistiche.nota }}{% endif %}</div>
    </div>
  </div>
  {% endif %}

  {% if pagamento %}
  <div class="detail-section">
    <p class="block-title">Modalità di pagamento</p>
    <div class="pay-cards">
      {% for p in pagamento %}
      <div class="pay-card">
        <div class="pct">{{ p.percentuale }}</div>
        <div class="fase">{{ p.fase }}</div>
        <div class="importo">{{ p.importo }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if note %}
  <div class="note-box">{{ note }}</div>
  {% endif %}

  <div class="contact-footer">
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="4.2mm" height="4.2mm">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span>389 902 1020</span>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="4.2mm" height="4.2mm">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <span>sebastianmarzola.work@gmail.com</span>
    </div>
    <div class="contact-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="4.2mm" height="4.2mm">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
        <path d="M2 12h20"/>
      </svg>
      <span>sebastian-marzola.it</span>
    </div>
  </div>
</div>
{% endif %}

</body>
</html>
